DATABASE_URL="postgresql://postgres:SENHA@localhost:5432/dashboard_alle?schema=public"

# Execute npm run api:token para gerar uma credencial local em .env.
# Configure um segredo próprio (mínimo 32 caracteres) no ambiente de produção.
API_TOKEN=""

# Faturamento do dashboard e sincronização de unidades pelo Bitrix (somente no servidor).
BITRIX_WEBHOOK_URL=""
BITRIX_DEAL_CATEGORY_ID="42"
BITRIX_CPF_FIELD="UF_CRM_1753823473272"
BITRIX_UNIT_FIELD="UF_CRM_1761834580685"

# Comprovantes financeiros: bucket S3 privado e exclusivo. Veja docs/comprovantes-s3.md.
# Opcionais enquanto não houver envio/leitura de comprovantes. Somente no servidor.
AWS_REGION=""
S3_RECEIPTS_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Preencha somente para credenciais temporárias.
AWS_SESSION_TOKEN=""
