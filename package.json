{
  "name": "dashboard-alle",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "api:token": "node scripts/create-api-token.mjs",
    "auth:admin": "node --import tsx scripts/bootstrap-admin.ts",
    "auth:test": "node --import tsx scripts/test-auth.ts && node --import tsx scripts/test-user-access.ts",
    "auth:test:http": "node --import tsx scripts/test-auth-http.ts",
    "api:test": "node --import tsx scripts/test-api.ts && node --import tsx scripts/test-api-catalogs.ts && node --import tsx scripts/test-api-finance.ts && node --import tsx scripts/test-api-commissions.ts",
    "api:test:db": "node --import tsx scripts/test-api-db.ts",
    "api:test:http": "node --import tsx scripts/test-api-http.ts",
    "api:docs": "node --import tsx scripts/generate-api-docs.ts",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:check": "node scripts/check-db.mjs",
    "db:export": "node scripts/export-db.mjs",
    "db:pull": "prisma db pull",
    "db:studio": "prisma studio",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "prebuild": "prisma generate",
    "pretypecheck": "prisma generate",
    "db:test-payment": "prisma generate && tsx scripts/test-payment.ts",
    "db:test-fixed-partner-commission": "node --import tsx scripts/test-fixed-partner-commission.ts",
    "db:test-commissions": "tsx scripts/test-commission-module.ts",
    "db:test-commission-overwrite": "node --import tsx scripts/test-commission-overwrite.ts",
    "db:test-commission-overwrite:http": "node --import tsx scripts/test-commission-overwrite-http.ts",
    "db:test-client-reconciliation": "node --import tsx scripts/test-client-reconciliation.ts",
    "db:test-commission-upgrade": "tsx scripts/test-commission-upgrade.ts"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "dotenv": "^18.0.4",
    "exceljs": "^4.4.0",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "prisma": "^7.10.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-is": "^19.3.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
