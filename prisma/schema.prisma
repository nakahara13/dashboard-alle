generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model criar_pagamento {
  tipo_id Int?
  tipo Tipo? @relation(fields: [tipo_id], references: [id], onDelete: Restrict)
  @@index([tipo_id])
  id_do_registro      BigInt    @id @default(autoincrement())
  id_do_pagamento     BigInt    @default(autoincrement())
  valor_total         Decimal   @db.Decimal(12, 2)
  data_do_pagamento   DateTime? @db.Date
  competencia_financeira String? @db.VarChar(7)
  beneficiario        String    @db.VarChar(255)
  pagador             String?   @db.VarChar(255)
  metodo_do_pagamento String?   @db.VarChar(100)
  status_do_pagamento String?   @db.VarChar(50)
  numero_da_nf        String?   @db.VarChar(100)
  parceiro_id         Int?
  parceiro            Parceiro? @relation(fields: [parceiro_id], references: [id], onDelete: Restrict)

  metodo_id Int?
  metodo MetodoPagamento? @relation(fields: [metodo_id], references: [id], onDelete: Restrict)

  conta_bancaria_id Int?
  conta_bancaria ContaBancaria? @relation(fields: [conta_bancaria_id], references: [id], onDelete: Restrict)

  comissao Comissao? @relation("EntradaComissao")
  descricao String? @db.VarChar(500)

  @@index([conta_bancaria_id])
  @@index([metodo_id])
  @@index([parceiro_id])
}

model Parceiro {
  id          Int      @id @default(autoincrement())
  nome        String   @db.VarChar(255)
  documento   String?  @unique @db.VarChar(30)
  email       String?  @db.VarChar(255)
  telefone    String?  @db.VarChar(30)
  criado_em   DateTime @default(now()) @db.Timestamptz(6)
  recebimentos criar_pagamento[]
  contas_a_pagar ContaPagar[]
  clientes Cliente[]
  unidades UnidadeAllpFit[]
  comissoes Comissao[]

  @@map("parceiros")
}

model MetodoPagamento {
  id Int @id @default(autoincrement())
  nome String @unique @db.VarChar(100)
  recebimentos criar_pagamento[]

  @@map("metodos_pagamento")
}

model ContaBancaria {
  id Int @id @default(autoincrement())
  nome String @db.VarChar(100)
  banco String @db.VarChar(100)
  agencia String @db.VarChar(20)
  numero String @db.VarChar(30)
  titular String @db.VarChar(255)
  recebimentos criar_pagamento[]

  @@unique([banco, agencia, numero])
  @@map("contas_bancarias")
}

model ContaPagar {
  tipo_id Int
  tipo Tipo @relation(fields: [tipo_id], references: [id], onDelete: Restrict)
  @@index([tipo_id])
  id BigInt @id @default(autoincrement())
  favorecido_id Int
  favorecido Parceiro @relation(fields: [favorecido_id], references: [id], onDelete: Restrict)
  descricao String @db.VarChar(500)
  centro_custo String? @db.VarChar(100)
  lancamento DateTime @db.Date
  competencia String @db.VarChar(7)
  vencimento DateTime @db.Date
  valor Decimal @db.Decimal(12, 2)
  status String @default("Pendente") @db.VarChar(20)

  comissao Comissao? @relation("SaidaComissao")

  @@index([favorecido_id])
  @@index([vencimento, id])
  @@map("contas_a_pagar")
}

model Tipo {
  id Int @id @default(autoincrement())
  nome String @unique @db.VarChar(100)
  recebimentos criar_pagamento[]
  contas_a_pagar ContaPagar[]
  @@map("tipos")
}

enum UserRole {
  admin
  gestor
}

model Usuario {
  id Int @id @default(autoincrement())
  nome String @db.VarChar(255)
  email String @unique @db.VarChar(255)
  role UserRole @default(gestor)
  criado_em DateTime @default(now()) @db.Timestamptz(6)

  @@map("usuarios")
}

model Cliente {
  // CPF opcional no cadastro manual, na importação e na pesquisa de clientes.
  cpf String? @db.VarChar(11)
  id Int @id @default(autoincrement())
  nome String @db.VarChar(255)
  uc String @unique @db.VarChar(100)
  parceiro_id Int?
  parceiro Parceiro? @relation(fields: [parceiro_id], references: [id], onDelete: Restrict)
  distribuidora_id Int?
  distribuidora Distribuidora? @relation(fields: [distribuidora_id], references: [id], onDelete: Restrict)
  unidade_id Int?
  unidade UnidadeAllpFit? @relation(fields: [unidade_id], references: [id], onDelete: Restrict)
  comissoes Comissao[]
  @@index([distribuidora_id])
  @@index([unidade_id])
  @@index([parceiro_id])
  @@map("clientes")
}

model Distribuidora {
  id Int @id @default(autoincrement())
  nome String @unique @db.VarChar(255)
  comissoes Comissao[]
  clientes Cliente[]
  @@map("distribuidoras")
}

model Comissao {
  id BigInt @id @default(autoincrement())
  cliente_id Int
  cliente Cliente @relation(fields: [cliente_id], references: [id], onDelete: Restrict)
  geradora_id Int?
  geradora Geradora? @relation(fields: [geradora_id], references: [id], onDelete: Restrict)
  distribuidora_id Int
  distribuidora Distribuidora @relation(fields: [distribuidora_id], references: [id], onDelete: Restrict)
  parceiro_id Int?
  parceiro Parceiro? @relation(fields: [parceiro_id], references: [id], onDelete: Restrict)
  competencia String @db.VarChar(7)
  valor_economia Decimal @db.Decimal(12, 2)
  valor_comissao_empresa Decimal @db.Decimal(12, 2)
  valor_comissao_parceiro Decimal @db.Decimal(12, 2)
  margem Decimal @db.Decimal(12, 2)
  status_recebimento String @default("Pendente") @db.VarChar(20)
  status_pagamento String @default("Não se aplica") @db.VarChar(20)
  data_recebimento DateTime? @db.Date
  data_pagamento DateTime? @db.Date
  entrada_id BigInt? @unique
  entrada criar_pagamento? @relation("EntradaComissao", fields: [entrada_id], references: [id_do_registro], onDelete: Restrict)
  saida_id BigInt? @unique
  saida ContaPagar? @relation("SaidaComissao", fields: [saida_id], references: [id], onDelete: Restrict)
  @@unique([cliente_id, geradora_id, competencia])
  @@index([parceiro_id])
  @@index([distribuidora_id, competencia])
  @@index([geradora_id, competencia])
  @@map("comissoes")
}

model Geradora {
  id Int @id @default(autoincrement())
  nome String @unique @db.VarChar(255)
  comissoes Comissao[]
  @@map("geradoras")
}

model UnidadeAllpFit {
  id Int @id @default(autoincrement())
  nome String @unique @db.VarChar(255)
  parceiro_id Int?
  parceiro Parceiro? @relation(fields: [parceiro_id], references: [id], onDelete: Restrict)
  clientes Cliente[]
  @@index([parceiro_id])
  @@map("unidades_allp_fit")
}
