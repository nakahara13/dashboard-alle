# Cole estas variáveis em Environment do serviço App no Easypanel.
# Copie a URL INTERNA exibida em Credentials do novo serviço PostgreSQL.
DATABASE_URL="postgresql://postgres:SENHA@HOST_INTERNO:5432/dashboard_alle?sslmode=disable"
NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"

# Gere um segredo exclusivo para produção; não use este texto de exemplo.
# API_TOKEN protege as integrações HTTP. O login usa as contas do banco.
API_TOKEN="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES"
