# Cole estas variáveis em Environment do serviço App no Easypanel.
# Copie a URL INTERNA exibida em Credentials do novo serviço PostgreSQL.
DATABASE_URL="postgresql://postgres:SENHA@HOST_INTERNO:5432/dashboard_alle?sslmode=disable"
NODE_ENV="production"
PORT="3000"
HOSTNAME="0.0.0.0"

# Acesso ao App somente pelo Traefik do Easypanel, sem porta pública direta.
# Confia no último IP acrescentado pelo proxy em X-Forwarded-For.
AUDIT_TRUST_PROXY="true"

# Gere um segredo exclusivo para produção; não use este texto de exemplo.
# API_TOKEN protege as integrações HTTP. O login usa as contas do banco.
API_TOKEN="SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES"

# Webhook de leitura para faturamento do dashboard e sincronização de unidades no Bitrix.
# Cole a URL privada apenas no ambiente do serviço App; nunca no código ou no frontend.
BITRIX_WEBHOOK_URL=""
BITRIX_DEAL_CATEGORY_ID="42"
BITRIX_CPF_FIELD="UF_CRM_1753823473272"
BITRIX_UNIT_FIELD="UF_CRM_1761834580685"

# Comprovantes financeiros: bucket S3 privado e exclusivo. Veja docs/comprovantes-s3.md.
# Opcionais enquanto não houver envio/leitura de comprovantes. Somente no servidor.
AWS_REGION=""
S3_RECEIPTS_BUCKET=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
# Preencha somente para credenciais temporárias.
AWS_SESSION_TOKEN=""
